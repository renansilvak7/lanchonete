function gerarCodigoPedido() {
    const caracteres =
        "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

    let codigo = "L7K-";

    for (let i = 0; i < 6; i++) {
        codigo += caracteres.charAt(
            Math.floor(
                Math.random() *
                caracteres.length
            )
        );
    }

    return codigo;
}

